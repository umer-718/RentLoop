<%- include("../partials/header", { pageTitle: item ? "Edit Item" : "List an Item" }) %>

<section class="form-section">
    <div class="form-card">
        <h1><%= item ? "Edit Your Listing" : "List an Item" %></h1>
        <p>Provide accurate information about the item you want to rent.</p>

        <% if (error) { %>
            <div class="alert"><%= error %></div>
        <% } %>

        <form
            action="<%= item ? '/items/' + item.id + '/edit' : '/items/add' %>"
            method="POST"
            enctype="multipart/form-data"
        >
            <label>Item Title</label>
            <input
                type="text"
                name="title"
                maxlength="150"
                value="<%= item ? item.title : '' %>"
                required
            >

            <label>Category</label>
            <select name="category_id" required>
                <option value="">Select Category</option>

                <% categories.forEach(category => { %>
                    <option
                        value="<%= category.id %>"
                        <%= item && String(item.category_id) === String(category.id) ? "selected" : "" %>
                    >
                        <%= category.name %>
                    </option>
                <% }) %>
            </select>

            <label>Description</label>
            <textarea name="description" rows="5" required><%= item ? item.description : '' %></textarea>

            <label>Rental Price Per Day (PKR)</label>
            <input
                type="number"
                name="price_per_day"
                min="1"
                step="0.01"
                value="<%= item ? item.price_per_day : '' %>"
                required
            >

            <label>Security Deposit (PKR)</label>
            <input
                type="number"
                name="security_deposit"
                min="0"
                step="0.01"
                value="<%= item ? item.security_deposit : '0' %>"
            >

            <label>Location</label>
            <input
                type="text"
                name="location"
                value="<%= item ? item.location : '' %>"
                required
            >

            <label>Item Image (JPG, PNG or WEBP; max 5 MB)</label>
            <input type="file" name="image" accept="image/jpeg,image/png,image/webp">

            <% if (item && item.image) { %>
                <img
                    src="/uploads/<%= item.image %>"
                    alt="Current item image"
                    class="form-preview"
                >
            <% } %>

            <% if (item) { %>
                <label>Listing Status</label>
                <select name="status">
                    <option value="AVAILABLE" <%= item.status === "AVAILABLE" ? "selected" : "" %>>
                        Available
                    </option>
                    <option value="UNAVAILABLE" <%= item.status === "UNAVAILABLE" ? "selected" : "" %>>
                        Unavailable
                    </option>
                </select>
            <% } %>

            <button class="btn btn-primary full-width">
                <%= item ? "Save Changes" : "Publish Listing" %>
            </button>
        </form>
    </div>
</section>

<%- include("../partials/footer") %>